# Application Environment
APP_ENV=development
DEBUG=True
API_PORT=8000
BOT_PORT=8001

# PostgreSQL Database (Asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5433/resumeiq_db

# Redis Distributed Cache & Session Store
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Engine
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_password
MINIO_BUCKET=resumes
MINIO_SECURE=False

# Apache Kafka Event Stream
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RESUME_UPLOADED=resume.uploaded
KAFKA_TOPIC_RESUME_PROCESSED=resume.processed
KAFKA_TOPIC_ANALYSIS_EVENTS=analysis.events
KAFKA_TOPIC_NOTIFY_EVENTS=notify.events
KAFKA_TOPIC_AGENT_TASKS=agent.tasks

# LLM & Embedding Model Settings (groq | gemini | openai | local)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Observability - Langfuse Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# External Job Market & Search APIs (Tavily AI / RapidAPI)
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com
TAVILY_API_KEY=
